#!/bin/sh
# The Focus Gate launcher: builds the Swift gate once per source and compiler change, then runs it.
#   tools/sdlc route|check --base BASE [--head HEAD] [--full]
#   tools/sdlc motor [--update-perception] | tools/sdlc fishing
#   tools/sdlc merge PR FULL_HEAD_SHA [--execute] [--into BRANCH]
set -eu
root=$(cd "$(dirname "$0")/.." && pwd -P)
set -- "$root/tools/Gate.swift" "$root/tools/MotorProof.swift" "$root/tools/FishingProof.swift" "$root/tools/Merge.swift" \
  "$root/experiments/002_wow_visual/runtime/JSON.swift" -- "$@"
sources=""
while [ "$1" != "--" ]; do sources="$sources $1"; shift; done
shift
# Absolute paths: the gate finds the repository from its own source path.
key=$( { swiftc --version 2>&1; for f in $sources; do printf '%s\n' "$f"; cat "$f"; done; } | shasum -a 256 | cut -c1-16)
bin="${TMPDIR:-/tmp}/jev-sdlc-$key"
if [ ! -x "$bin" ]; then
  # shellcheck disable=SC2086
  swiftc -parse-as-library -O $sources -o "$bin.$$" >&2
  mv -f "$bin.$$" "$bin"
fi
exec "$bin" "$@"
